# Environment & General Config
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET_KEY=marketpulse_enterprise_super_secret_key_change_in_production_9876543210
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./marketpulse.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://marketpulse_user:secure_password@localhost:5432/marketpulse_db

# Redis Configuration (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Intelligence Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# CORS Origins (comma-separated or regex)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
